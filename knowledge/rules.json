      {"word": "가장 저렴", "reason": "근거 없는 최상급 가격 비교", "suggestion": "부담 없는 가격"},
      {"word": "세계 최고", "reason": "근거 없는 최상급 표현", "suggestion": "(삭제)"},
      {"word": "100% 효과", "reason": "효과 보장 표현", "suggestion": "(삭제)"},
      {"word": "효과 보장", "reason": "효과 보장 표현", "suggestion": "(삭제)"},
      {"word": "부작용 없", "reason": "안전성 단정 표현", "suggestion": "순한 사용감"},
      {"word": "무조건 사", "reason": "구매 강요 표현", "suggestion": "한번 써 볼 만해"},
      {"word": "완벽한 제품", "reason": "근거 없는 절대 표현", "suggestion": "만족스러운 제품"},
      {"word": "내돈내산", "reason": "협찬인데 직접 구매로 오인시키는 표현", "suggestion": "[광고] 표시"}
    ],
    "by_category": {
      "화장품": [
        {"word": "피부가 새로 태어", "reason": "피부 재생(의약품 효능) 오인", "suggestion": "피부가 정돈돼 보여요"},
