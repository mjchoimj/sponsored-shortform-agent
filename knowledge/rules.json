{
  "version": "1.0",
  "notes": "검증 코드(app/checks, mcp_server)가 판정에 쓰는 규칙. 판정은 코드가 하고 LLM은 쓰지 않는다. 출처: 공정위 추천·보증 등에 관한 표시·광고 심사지침, 화장품법·식품표시광고법의 일반적 금지 유형을 MVP용으로 요약.",

  "categories": {
    "supported": ["생활용품", "전자·액세서리", "일반식품", "화장품"],
    "rejected": ["건강기능식품", "의약품", "의료기기"],
    "rejected_message": "건강기능식품·의약품·의료기기는 별도 법(심의·허가)이 적용되어 이 도구로 기획하지 않습니다."
  },

  "length": {
    "allowed_sec": [15, 30, 45, 60],
    "max_points_in_video": {"15": 2, "30": 3, "45": 4, "60": 5},
    "scene_sec_integer": true,
    "scene_total_must_equal_length": true
  },

  "hook": {
    "max_sec": 3,
    "product_visible_allowed": false
  },

  "product_exposure": {
    "max_ratio": 0.3,
    "how": "product_visible 이 true 인 씬 길이 합 ÷ 전체 길이"
  },

  "ad_disclosure": {
    "where": ["title", "description_first_line"],
    "allowed": ["[광고]", "#광고"],
    "fail_if_alone": ["sponsored", "ad", "#ad", "#sponsored", "#내돈내산", "협찬 아님"],
    "fail_if_alone_match": "대소문자 무시, 영문은 단어 단위로 일치할 때만 (예: 'ad' 는 'add' 'shadow' 에 걸리지 않음)",
    "recommend_in_video": "영상 안 '유료광고 포함' 표시는 권장 안내만 하고 채점하지 않는다."
  },

  "forbidden_expressions": {
    "match": "부분 문자열 일치, 공백 무시",
    "common": [
      {"word": "최고급", "reason": "근거 없는 최상급 표현", "suggestion": "고급스러운"},
      {"word": "업계 최초", "reason": "근거 없는 최초 주장", "suggestion": "(삭제)"},
