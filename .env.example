# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# 필수: AWS Bedrock 접속
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_REGION=us-east-1   # Bedrock 호출 리전

# 선택: 모델 바꾸기 (비워 두면 app/config.py 기본값 사용)
# GEN_MODEL=            # 기획 생성용 (경량 모델)
# GEN_MODEL_FALLBACKS=  # 생성 모델이 실패할 때 차례로 쓸 모델, 쉼표로 구분
# GRADER_MODEL=         # 최종 채점용 (한 단계 위 모델)

# 선택: Trace (P1) — 키가 있으면 LangSmith 로, 없으면 logs/ 폴더에 로컬 기록
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sponsored-shortform

# 선택: 웹 리서치 (P2)
TAVILY_API_KEY=
