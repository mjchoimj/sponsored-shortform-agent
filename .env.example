# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요. .env 는 절대 커밋하지 않습니다.

# 필수
OPENAI_API_KEY=

# 선택: 모델 바꾸기 (비워 두면 app/config.py 기본값 사용)
# GEN_MODEL=          # 기획 생성용 (경량 모델)
# GEN_MODEL_FALLBACKS=  # 생성 모델이 실패할 때 차례로 쓸 모델, 쉼표로 구분
# GRADER_MODEL=       # 최종 채점용 (한 단계 위 모델)
# EMBEDDING_MODEL=    # RAG 임베딩

# 선택: Trace (P1)
LANGSMITH_API_KEY=

# 선택: 웹 리서치 (P2)
TAVILY_API_KEY=
